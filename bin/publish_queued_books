#!/usr/bin/env perl

use v5.40;
use YAML::XS  qw(LoadFile DumpFile);
use JSON::PP  qw();
use DateTime;

local $YAML::XS::Boolean = 'JSON::PP';

my $books_path = '_data/books.yml';

my $today = DateTime->today->ymd;

my $books = -f $books_path ? ( LoadFile($books_path) // [] ) : [];

my @published;

for my $book (@$books) {
    next if $book->{live};
    next unless "$book->{published}" le $today;

    $book->{live} = JSON::PP::true;
    push @published, $book->{slug};
}

DumpFile( $books_path, $books );

say $_ for @published;
